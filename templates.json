{
  "$schema_notes": "e360 Showrunner event-type seed templates. A Project Folder (engagement) holds 1+ Shows (dated productions). Instantiating a template on a Show materializes event_steps with due_date = show.event_date + due_offset_days (offset is negative = days BEFORE the event, 0 = event/install day, positive = after). depends_on references another step's exact title (across any lane in the same template) and is null when the step has no prerequisite. Every prerequisite's due_offset_days is <= its dependent's, so a back-scheduled date never falls after the step that needs it.",
  "enums": {
    "event_type": ["led", "print", "both"],
    "lanes": ["client", "venue", "logistics", "crew", "gear", "deliverables"],
    "owner_role": [
      "sales",
      "account_manager",
      "pm",
      "technical_director",
      "content_manager",
      "lead_tech",
      "gear_lead",
      "logistics_coordinator",
      "graphic_designer",
      "print_producer"
    ],
    "evidence_type": ["flex_element", "doc_link", "booking", "file", "none"],
    "auto_source": ["spec_gen", "novaspec", "powerspec", "flex", "travel", "none"]
  },
  "spec_derivation_chain": {
    "note": "Deliverables lane, LED/Both only. content spec (.e360, spec_gen) -> data cabling (.nsf, novaspec) -> power (.pcfg, powerspec) -> Flex pull sheet (gear count). Each is DERIVED from the prior; regenerating a parent marks every descendant stale. Modeled here via depends_on so a downstream step can be flagged when its upstream evidence is re-bound. See INTEGRATION.md part (a).",
    "order": [
      "Content spec sheet (.e360) generated",
      "Data cabling map (.nsf) generated",
      "Power spec (.pcfg) generated",
      "Build pull sheet in Flex"
    ]
  },
