# ════════════════════════════════════════════════════════════════════════════
# E360 Showrunner — environment
# ────────────────────────────────────────────────────────────────────────────
# Copy to .env (gitignored) or paste into Railway's variable store.
# EVERY VALUE BELOW IS EITHER A PLACEHOLDER OR PUBLIC. No secret is committed
# here and none ever should be.
#
# Sensible default posture: with the integration blocks left UNSET, Showrunner
# runs completely — it just answers 501 on the two outbound paths (live push,
# Flex) with a message naming the missing variable, instead of failing oddly.
# ════════════════════════════════════════════════════════════════════════════

# ── core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/showrunner?sslmode=disable
PORT=3100
# The staffing app also reads the bare PORT and defaults to 3000. Launching both
# from one shell with PORT set collides — set it per process.
NODE_ENV=development
PG_POOL_MAX=10

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origin allowlist. UNSET = same-origin only, which is correct
# for a Railway app serving its own SPA. The spec-bind flow needs NO entry here:
# the tools make zero cross-origin XHR (popup + postMessage + first-party fetch).
# CORS_ORIGINS=https://showrunner.example.com

# ── storage (the NAS) ────────────────────────────────────────────────────────
# local (default) | smb | webdav — the last two are stubs that throw a clear 501.
STORAGE_DRIVER=local
# STORAGE_ROOT=./.storage
# SHOWRUNNER_NAS_ROOT=\\E360-NAS\Showrunner
# MAX_UPLOAD_BYTES=104857600

# ── body limits ──────────────────────────────────────────────────────────────
# JSON bodies are metadata, never bytes. Raw uploads have their own raw() routes.
# JSON_BODY_LIMIT=1mb
# D3. ONE route is exempt: POST /api/shows/:id/spec-bind carries
# json + svg + pageHtml + png, where png is a base64 data URL of a 2x-scaled
# canvas and pageHtml inlines every stylesheet — realistically 2-10 MB. Scoped
# to that route so the 1 MB default keeps protecting everything else.
# SPEC_BIND_BODY_LIMIT=25mb

# ════════════════════════════════════════════════════════════════════════════
# PUSH TO SCHEDULER — the staffing app (e360-staffing3)
# ────────────────────────────────────────────────────────────────────────────
# UNSET = the live push answers 501 and names what is missing. The dry run works
# either way and shows byte-for-byte what live would send.
#
# ⚠ SCHEDULER_API_TOKEN IS RETIRED — do not reintroduce it. The staffing app has
#   no API-key path and no service-credential mechanism: sessions are an
#   in-memory Map with a 12 h TTL, wiped on every redeploy. A static token is
#   dead within hours or one deploy, whichever comes first. Showrunner logs in
#   programmatically and retries once on 401 (INTEGRATIONS_SPEC.md §1.4.1).
# ════════════════════════════════════════════════════════════════════════════
# The Staffing & Planner production deployment (confirmed by Tom, §8 addendum):
# SCHEDULER_BASE_URL=https://web-production-f9d318.up.railway.app
# The dedicated service account — created in the staffing app's Users tab, role
# `edit`. NOT a human login: you want the audit trail to name the robot.
# Credentials live in Tom's password manager.
# SCHEDULER_USER=showrunner
# SCHEDULER_PASS=
# SCHEDULER_TIMEOUT_MS=20000

# ════════════════════════════════════════════════════════════════════════════
# FLEX (Flex Rental Solutions) — gear
# ────────────────────────────────────────────────────────────────────────────
# UNSET = every function in lib/flex.js throws a 501 naming the missing var.
# Never a silent noop: a Flex client that quietly returns [] is indistinguishable
# from "the gear list is empty", which is exactly BUG 5's failure mode.
#
# FLEX_BASE_URL is public. FLEX_API_KEY is NOT and is not in this repo — it
# exists only in the e360-staffing3 Railway variable store. Tom copies it across
# himself; it is never committed and never pasted into chat.
# One tenant-wide key is shared by all users, so Flex's audit log attributes
# every API-created element to Tom.
# ════════════════════════════════════════════════════════════════════════════
# FLEX_BASE_URL=https://e360sport.flexrentalsolutions.com
# FLEX_API_KEY=
# FLEX_TIMEOUT_MS=20000
# R17 guards on the Event Folder tree walk — one /identity call per node against
# an API Flex itself calls BETA.
# FLEX_TREE_MAX_DEPTH=4
# FLEX_TREE_MAX_NODES=200
# FLEX_IDENTITY_BATCH=5
# R19: the staffing original caches the current user forever with no reset path,
# so a rotated key needs a process restart. This one has a TTL.
# FLEX_USER_CACHE_MS=1800000

# ════════════════════════════════════════════════════════════════════════════
# SPEC BIND — the three browser tools
# ────────────────────────────────────────────────────────────────────────────
# D4. Which origins may postMessage a spec bundle into the ?bind-spec=1 popup.
# Comma-separated; served to the SPA at GET /api/config and NEVER hardcoded in
# public/. All four E360 tools share ONE static origin, so this is effectively
# one entry plus a localhost entry for dev.
#
# The staffing app's equivalent handler checks no origin at all (defect T1) and
# posts its ready message with target '*'. Ours checks both directions.
#
# REQUIRED IN PRODUCTION if anyone is to bind a spec. Unset, the allowlist is
# empty and the popup refuses every bundle — correct, and now audible:
# GET /api/config reports features.specBind:false and the popup says
# "not configured on this server" on open rather than timing out at 30s.
# ════════════════════════════════════════════════════════════════════════════
# TOOLS_ORIGINS=https://e360-tools-production.up.railway.app,http://localhost:3000

# ── seeds / dev conveniences ─────────────────────────────────────────────────
# SEED_ROSTER=1
# SMOKE_PORT=31879
