# ════════════════════════════════════════════════════════════════════════════
# E360 Showrunner — environment
# ────────────────────────────────────────────────────────────────────────────
# Copy to .env (gitignored) or paste into Railway's variable store.
# EVERY VALUE BELOW IS EITHER A PLACEHOLDER OR PUBLIC. No secret is committed
# here and none ever should be.
#
# Sensible default posture: with the integration blocks left UNSET, Showrunner
# runs completely — it just answers 501 on the two outbound paths (live push,
# Flex) with a message naming the missing variable, instead of failing oddly.
# ════════════════════════════════════════════════════════════════════════════

# ── core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/showrunner?sslmode=disable
PORT=3100
# The staffing app also reads the bare PORT and defaults to 3000. Launching both
# from one shell with PORT set collides — set it per process.
NODE_ENV=development
PG_POOL_MAX=10

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origin allowlist. UNSET = same-origin only, which is correct
# for a Railway app serving its own SPA. The spec-bind flow needs NO entry here:
# the tools make zero cross-origin XHR (popup + postMessage + first-party fetch).
# CORS_ORIGINS=https://showrunner.example.com

# ════════════════════════════════════════════════════════════════════════════
# STORAGE — the NAS byte layer.  Full runbook: WIRING_DAY.md
# ════════════════════════════════════════════════════════════════════════════
# Two-tier: METADATA in Postgres, BYTES on the NAS. Nothing in the app opens a
# UNC path — every byte goes through lib/storage.js, so which NAS and how it is
# reached are env decisions, not code.
#
#   local  (default)  writes under STORAGE_ROOT. Correct for dev, for CI, and
#                     in production when the NAS is mounted on the host.
#   webdav            REAL — the Synology's WebDAV Server package over HTTPS,
#                     optionally through the Tailscale SOCKS proxy below.
#   smb               not implemented; an honest 501 that points at webdav.
STORAGE_DRIVER=local
# STORAGE_ROOT=./.storage
# The logical root every nas_path is expressed against. A LABEL, not a route:
# operators read it out of the UI and paste it into Explorer. Nothing dials it.
# SHOWRUNNER_NAS_ROOT=\\E360-NAS\Showrunner
# Enforced by both drivers BEFORE a byte leaves the process.
# MAX_UPLOAD_BYTES=104857600

# ── the Synology, over WebDAV ────────────────────────────────────────────────
# The path is the SHARE name. No trailing slash. With STORAGE_DRIVER=webdav and
# any of the three below missing, every byte call is a 501 that NAMES the
# missing variable — never a silent failure.
# NAS_WEBDAV_URL=https://e360-nas.tail1a2b3.ts.net:5006/showrunner
# NAS_WEBDAV_USER=svc-showrunner
# NAS_WEBDAV_PASS=
# Per-request deadline. On expiry: 504, "the record is intact; the bytes did
# not move."
# NAS_WEBDAV_TIMEOUT_MS=30000
#
# THE CERTIFICATE. A Synology reached by its tailnet name presents a cert
# issued for its LAN/DDNS name, so verification fails by default — loudly, with
# both fixes named. Three ways out, best first:
#   (a) `tailscale cert <name>.ts.net` on the NAS, install it in DSM for the
#       WebDAV service -> a real Let's Encrypt chain, and NEITHER var below is
#       needed.
#   (b) NAS_WEBDAV_CA — pin the NAS cert; verification stays ON.
#   (c) NAS_WEBDAV_ALLOW_SELF_SIGNED=1 — verification off FOR THIS DRIVER ONLY.
#       Acceptable because the transport is already an authenticated WireGuard
#       tunnel. It is NOT NODE_TLS_REJECT_UNAUTHORIZED: Flex, Graph and the
#       staffing app keep full verification. /api/health reports which of the
#       three is in force, so a deployment cannot be mistaken for verified.
# NAS_WEBDAV_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# NAS_WEBDAV_ALLOW_SELF_SIGNED=1

# ── Tailscale — how a Railway container reaches a NAS on the tailnet ─────────
# THE SWITCH. Set, docker-entrypoint.sh starts `tailscaled --tun=userspace-
# networking --socks5-server=localhost:1055` and lib/storage.js routes the NAS
# host — AND ONLY THE NAS HOST — through it. Unset, no daemon starts, no proxy
# is used, and the whole feature is inert.
# TAILSCALE_AUTHKEY=tskey-auth-...
# The node name in the Tailscale admin console.
# TAILSCALE_HOSTNAME=showrunner
# Override the implied localhost:1055. Accepts host:port or a socks5:// URL.
# TAILSCALE_SOCKS=127.0.0.1:1055
# Wins over everything else — the escape hatch for "the NAS is reachable
# directly today and tailscaled is in the way".
# TAILSCALE_SOCKS_DISABLE=1
# By DEFAULT a failed tailnet join is a loud warning and the app boots anyway:
# schedules, budgets, notes, POs and the agent surface do not need the NAS, and
# byte routes report their own honest 502. Set this to make it a hard failure.
# TAILSCALE_REQUIRED=1

# ── body limits ──────────────────────────────────────────────────────────────
# JSON bodies are metadata, never bytes. Raw uploads have their own raw() routes.
# JSON_BODY_LIMIT=1mb
# D3. ONE route is exempt: POST /api/shows/:id/spec-bind carries
# json + svg + pageHtml + png, where png is a base64 data URL of a 2x-scaled
# canvas and pageHtml inlines every stylesheet — realistically 2-10 MB. Scoped
# to that route so the 1 MB default keeps protecting everything else.
# SPEC_BIND_BODY_LIMIT=25mb

# ════════════════════════════════════════════════════════════════════════════
# PUSH TO SCHEDULER — the staffing app (e360-staffing3)
# ────────────────────────────────────────────────────────────────────────────
# UNSET = the live push answers 501 and names what is missing. The dry run works
# either way and shows byte-for-byte what live would send.
#
# ⚠ SCHEDULER_API_TOKEN IS RETIRED — do not reintroduce it. The staffing app has
#   no API-key path and no service-credential mechanism: sessions are an
#   in-memory Map with a 12 h TTL, wiped on every redeploy. A static token is
#   dead within hours or one deploy, whichever comes first. Showrunner logs in
#   programmatically and retries once on 401 (INTEGRATIONS_SPEC.md §1.4.1).
# ════════════════════════════════════════════════════════════════════════════
# The Staffing & Planner production deployment (confirmed by Tom, §8 addendum):
# SCHEDULER_BASE_URL=https://web-production-f9d318.up.railway.app
# The dedicated service account — created in the staffing app's Users tab, role
# `edit`. NOT a human login: you want the audit trail to name the robot.
# Credentials live in Tom's password manager.
# SCHEDULER_USER=showrunner
# SCHEDULER_PASS=
# SCHEDULER_TIMEOUT_MS=20000

# ════════════════════════════════════════════════════════════════════════════
# FLEX (Flex Rental Solutions) — gear
# ────────────────────────────────────────────────────────────────────────────
# UNSET = every function in lib/flex.js throws a 501 naming the missing var.
# Never a silent noop: a Flex client that quietly returns [] is indistinguishable
# from "the gear list is empty", which is exactly BUG 5's failure mode.
#
# FLEX_BASE_URL is public. FLEX_API_KEY is NOT and is not in this repo — it
# exists only in the e360-staffing3 Railway variable store. Tom copies it across
# himself; it is never committed and never pasted into chat.
# One tenant-wide key is shared by all users, so Flex's audit log attributes
# every API-created element to Tom.
# ════════════════════════════════════════════════════════════════════════════
# FLEX_BASE_URL=https://e360sport.flexrentalsolutions.com
# FLEX_API_KEY=
# FLEX_TIMEOUT_MS=20000
# R17 guards on the Event Folder tree walk — one /identity call per node against
# an API Flex itself calls BETA.
# FLEX_TREE_MAX_DEPTH=4
# FLEX_TREE_MAX_NODES=200
# FLEX_IDENTITY_BATCH=5
# R19: the staffing original caches the current user forever with no reset path,
# so a rotated key needs a process restart. This one has a TTL.
# FLEX_USER_CACHE_MS=1800000

# ════════════════════════════════════════════════════════════════════════════
# SPEC BIND — the three browser tools
# ────────────────────────────────────────────────────────────────────────────
# D4. Which origins may postMessage a spec bundle into the ?bind-spec=1 popup.
# Comma-separated; served to the SPA at GET /api/config and NEVER hardcoded in
# public/. All four E360 tools share ONE static origin, so this is effectively
# one entry plus a localhost entry for dev.
#
# The staffing app's equivalent handler checks no origin at all (defect T1) and
# posts its ready message with target '*'. Ours checks both directions.
#
# REQUIRED IN PRODUCTION if anyone is to bind a spec. Unset, the allowlist is
# empty and the popup refuses every bundle — correct, and now audible:
# GET /api/config reports features.specBind:false and the popup says
# "not configured on this server" on open rather than timing out at 30s.
# ════════════════════════════════════════════════════════════════════════════
# TOOLS_ORIGINS=https://e360-tools-production.up.railway.app,http://localhost:3000

# ── seeds / dev conveniences ─────────────────────────────────────────────────
# SEED_ROSTER=1
# SMOKE_PORT=31879

# ════════════════════════════════════════════════════════════════════════════
# MAIL — F3, the notification outbox's delivery layer  (lib/mail.js)
# ────────────────────────────────────────────────────────────────────────────
# Every REAL delivery — work assigned to you, an @mention of you, a notify-
# picker pick, a tech-show-report nag — is queued into `notification_outbox`
# and flushed by a driver. The BELL is unchanged and stays primary; this is the
# SECOND channel, and each person's own preference decides whether it fires.
#
# MAIL_DRIVER=log   (DEFAULT, AND NOT A STUB)
#   Records the delivery in the activity trail and marks the row sent. On a box
#   with no mailbox that is the honest behaviour: the notification is recorded,
#   addressed and auditable — it simply travelled zero metres. Every test suite
#   runs against it.
#
# MAIL_DRIVER=graph  (the Microsoft Graph sendMail SKELETON)
#   Sends from the dedicated showrunner@ mailbox — app registration, admin-
#   consented, ApplicationAccessPolicy-locked to that ONE mailbox (Tom's design,
#   TEAM_FEEDBACK 2026-08-27). THE WIRE CALL IS DELIBERATELY NOT WRITTEN YET:
#   the mailbox and the app registration are an M365-admin task that has not
#   happened, so there is nothing to authenticate against and a half-written
#   client would be untestable fiction. Everything up to the wire IS built —
#   config detection, the token + sendMail URLs, the exact JSON body, and the
#   failure contract.
#
#   Selected but not configured, it answers a 501-shaped "mail not configured"
#   naming the missing vars, AND THE ITEM STAYS QUEUED. That is the difference
#   between "we cannot send this yet" and "we will never send this": turning
#   these on later delivers the backlog rather than discovering it was thrown
#   away. GET /api/admin/mail-status reports exactly this.
#
# SYSTEM MAIL IS NOT AGENT OUTBOUND. "File-don't-fire" (AGENT_API.md §9) is
# about an agent sending mail AS A PERSON. This is the app telling a person
# that something of theirs changed, from its own mailbox, on that person's
# stated preference. Nothing here reads a mailbox, signs as a user, or replies.
# ════════════════════════════════════════════════════════════════════════════
# MAIL_DRIVER=log
# MAIL_FROM=showrunner@e360sport.com
# MAIL_TENANT_ID=00000000-0000-0000-0000-000000000000
# MAIL_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MAIL_CLIENT_SECRET=
# MAIL_REPLY_TO=
# Used to make the deep link inside a message absolute. Unset leaves it
# relative — still useful, still honest.
# APP_BASE_URL=https://showrunner.up.railway.app

# ════════════════════════════════════════════════════════════════════════════
# THE LIFECYCLE + THE SWEEP — F2 / F6
# ────────────────────────────────────────────────────────────────────────────
# THERE IS NO SCHEDULER IN THIS APP, and it does not pretend otherwise. The
# sweep runs (a) once on boot — which on Railway means every redeploy — and
# (b) on POST /api/admin/sweep. It is idempotent: it strikes shows whose date
# has passed, creates and re-sends the tech reports their crews owe, re-checks
# every closeout, auto-archives what is ripe, and flushes the immediate queue.
# A real daily job needs Railway cron or the per-user agents (ARCHITECTURE.md).
# ════════════════════════════════════════════════════════════════════════════
# How long a tech has to file a show report after strike.
# TECH_REPORT_DUE_DAYS=3
# Days after closeout completes (recap sent + every report filed + no money
# waiting on paperwork) before a show auto-archives. Tom's number.
# ARCHIVE_AFTER_DAYS=60
# Set to 0 to skip the boot sweep entirely.
# SWEEP_ON_BOOT=1
# How far back the sweep reaches to strike a show it has never seen. The first
# boot after this release meets a database full of shows that already happened;
# without a bound it would strike all of them and nag every crew member about a
# job from last year. Anything older is HISTORY — a pm can still strike it by
# hand. A show already struck is unaffected, and closeout/archiving have no
# lookback at all: they are pure re-checks of the record.
# SWEEP_LOOKBACK_DAYS=45
